&HEAD CHID='firetwin_iss', TITLE='FireTwin ISS lab module, microgravity: Heptane, 30.0% O2, 10.0 cm/s' /
&TIME T_END=60.0, DT=0.2, LOCK_TIME_STEP=.TRUE. /
&DUMP NFRAMES=20 /
&MESH IJK=35,11,11, XB=-4.25,4.25,-1.38,1.38,-1.38,1.38 /
&MISC GVEC=0.0,0.0,0.0, Y_O2_INFTY=0.3286, P_INF=101300.0 /
&REAC FUEL='N-HEPTANE', C=7, H=16, O=0, SOOT_YIELD=0.037, HEAT_OF_COMBUSTION=44600. /
&SURF ID='FIRE', HRRPUA=1.4, COLOR='ORANGE' /
&OBST XB=-0.121,0.121,-0.125,0.125,-0.125,0.125, SURF_ID='FIRE' / one-cell burner at the module centre
&SURF ID='SUPPLY', VEL=-0.1, COLOR='BLUE' /
&SURF ID='EXHAUST', VEL=0.1, COLOR='GRAY' /
&VENT XB=-4.25,-4.25,-1.38,1.38,-1.38,1.38, SURF_ID='SUPPLY' / cabin fans (upstream wall)
&VENT XB=4.25,4.25,-1.38,1.38,-1.38,1.38, SURF_ID='EXHAUST' / return (downstream wall)
&DEVC ID='vent_fwd', XYZ=4.0,0.0,1.37, QUANTITY='DENSITY', SPEC_ID='SOOT' /
&DEVC ID='vent_aft', XYZ=-4.0,0.0,1.37, QUANTITY='DENSITY', SPEC_ID='SOOT' /
&DEVC ID='vent_mid', XYZ=0.0,0.0,1.37, QUANTITY='DENSITY', SPEC_ID='SOOT' /
&SLCF PBY=0.0, QUANTITY='DENSITY', SPEC_ID='SOOT', CELL_CENTERED=.TRUE. / mid-plane through the fire (replayable in FireTwin)
&SLCF PBY=0.0, QUANTITY='TEMPERATURE', CELL_CENTERED=.TRUE. /
&SLCF PBY=0.0, QUANTITY='VELOCITY', VECTOR=.TRUE. /
&TAIL /
