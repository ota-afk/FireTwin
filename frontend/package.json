{
  "name": "flame-in-freefall-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "openapi-typescript ${VITE_API_URL:-http://localhost:8000}/openapi.json -o src/api/schema.d.ts",
    "model:iss": "bash scripts/blender/build_iss_model.sh",
    "model:interior": "bash scripts/blender/build_iss_model.sh --interior",
    "fds:slice": "vite-node scripts/fds_slice_to_json.ts",
    "fds:deck": "vite-node scripts/make_fds_deck.ts",
    "fds:sample": "vite-node scripts/make_fds_sample.ts",
    "model:iss:check": "python3 scripts/blender/optimize_iss.py --self-test"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "htm": "3.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.3",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
